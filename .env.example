# PostgreSQL Database Configuration
POSTGRES_VERSION=17-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tickets_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async Database URL for SQLAlchemy (asyncpg)
# In Docker compose environment, the host is 'db'. For local host development without docker, use 'localhost'.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/tickets_db

# SLA Thresholds (in seconds)
SLA_WARNING_SECONDS=60
SLA_OVERDUE_SECONDS=180

# Service Ports
API_PORT=8000
FRONTEND_PORT=3000

# Worker and Sweeper Intervals (in seconds)
WORKER_POLL_INTERVAL_SECONDS=2
SLA_SWEEPER_INTERVAL_SECONDS=5

# Notification Simulation Delay (in seconds, for tests / demo)
NOTIFICATION_DELAY_SECONDS=0
